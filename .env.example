# VPSim configuration.
#
#   cp .env.example .env       then fill in GROQ_API_KEY
#
# .env is git-ignored and must stay that way. Never commit a real value —
# and if you ever do, rotating the key is mandatory even after you delete the
# commit. Git history is distributed; assume it was cloned (SECURITY_SPEC §5.1).
#
# Every variable below is declared in nidan/config.py and validated at start-up.
# An invalid value stops the app with a message naming the variable, rather than
# failing later in the middle of a consultation.


# ─────────────────────────────────────────────────────────────────────
# The language model
# ─────────────────────────────────────────────────────────────────────

# Required for the patient to reply. Get one free at https://console.groq.com
#
# The app STARTS without it — the gateway builds its client lazily — so you can
# browse cases, run the test suite and work on the assessment engine with no
# key at all. Only the consultation itself needs it.
GROQ_API_KEY=

# Default model for every purpose.
GROQ_MODEL=llama-3.3-70b-versatile

# Optional per-purpose overrides (ADR-0011). Unset, each falls back to
# GROQ_MODEL. Purposes: patient, feedback, extraction, judge.
# GROQ_MODEL_PATIENT=llama-3.1-8b-instant
# GROQ_MODEL_FEEDBACK=llama-3.3-70b-versatile


# ─────────────────────────────────────────────────────────────────────
# The web application
# ─────────────────────────────────────────────────────────────────────

# Signs browser session cookies.
#
# Leave EMPTY for local work: a random key is generated at start-up, which
# means your browser session ends when you restart the server. Set a fixed
# value if that annoys you.
#
# In any deployed environment this MUST be a real secret — anyone who knows it
# can forge a session cookie. Generate one with:
#     python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Port for `python -m nidan`. Compose maps the container's 8000 separately.
PORT=8000

# Flask debug mode: auto-reload and an interactive traceback console.
#
# NEVER true in a deployed environment. The debugger allows remote code
# execution (SECURITY_SPEC §3, T5).
DEBUG=false


# ─────────────────────────────────────────────────────────────────────
# Observability
# ─────────────────────────────────────────────────────────────────────

# DEBUG | INFO | WARNING | ERROR | CRITICAL
#
# A misspelt level is rejected at start-up. Left to the logging library it
# would be accepted and silently produce no output at all.
#
# Raw question text is never logged at INFO or above whatever this is set to
# (TECH_SPEC §10) — DEBUG is for local diagnosis, not for capturing transcripts.
LOG_LEVEL=INFO

# development | test | staging | production
#
# Tags Sentry events, so a staging error is not investigated as a live one.
ENVIRONMENT=development

# Sentry error reporting. Empty disables it — the normal state locally and in
# tests. PII is switched off in code (send_default_pii=False) and cannot be
# turned on from configuration.
SENTRY_DSN=

# Version tag attached to Sentry events, so a spike can be traced to a deploy.
# Defaults to the package version, e.g. nidan@0.2.0.
RELEASE=


# ─────────────────────────────────────────────────────────────────────
# Database  — set by docker-compose
# ─────────────────────────────────────────────────────────────────────

# PostgreSQL connection string. Required since T-013: session state is an
# append-only event log, so the app cannot serve a consultation without it.
# DATABASE_URL=postgresql://nidan:nidan_local_dev_only@localhost:5432/nidan


# ─────────────────────────────────────────────────────────────────────
# Commercial limits (T-017)
# ─────────────────────────────────────────────────────────────────────

# Cases a FREE user may start per calendar month, in their own timezone.
# Decided 11 September 2026 (PRD §11). Pro is unlimited.
#
# Configured rather than schema: the number is a pricing decision, and pricing
# decisions change faster than database migrations should.
#
# Every STARTED session counts, including abandoned ones — otherwise a free
# user could start and abandon without limit and the cap would mean nothing.
# FREE_TIER_SESSIONS_PER_MONTH=3


# ─────────────────────────────────────────────────────────────────────
# Authentication  — Supabase Auth (ADR-0002, T-014)
# ─────────────────────────────────────────────────────────────────────

# Your Supabase project URL. Both the JWKS endpoint and the expected token
# issuer are derived from it, so they cannot drift apart.
#
# Leave it empty to run without accounts: the prototype's consultations are
# anonymous trial sessions (PRD FR-2) and need no login. Only the /v1 API
# requires a token, and it answers 503 rather than 401 when this is unset —
# "we cannot verify" is not "your credentials are bad".
# SUPABASE_URL=https://your-project-ref.supabase.co

# The `aud` claim every user token must carry. Supabase issues 'authenticated';
# change this only if your project does something unusual.
#
# It is verified on every request, and that matters more than it looks: without
# an audience check, a valid token from ANY other Supabase project — a free
# account takes a minute to create — would pass signature verification and
# authenticate as whatever user id it names.
# SUPABASE_JWT_AUDIENCE=authenticated


# ─────────────────────────────────────────────────────────────────────
# docker-compose only
# ─────────────────────────────────────────────────────────────────────
# Read by docker-compose.yml, not by the application. All have defaults, so
# `docker compose up` works with no .env at all — override only if a port is
# already taken or you want a different database name.

# POSTGRES_USER=nidan
# POSTGRES_PASSWORD=nidan_local_dev_only
# POSTGRES_DB=nidan
# POSTGRES_PORT=5432
# APP_PORT=8000
