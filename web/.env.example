# Nidan web app — copy to .env.local and fill in. Never commit .env.local.

# The Supabase project (ADR-0017: `Nidan`, eu-central-1). The URL is public and
# is in docs/process/LOCAL_ADMIN_ACCESS.md. The anon key is public by design
# (it is shipped to browsers) but is sent privately so it is not indexed.
# NEVER put the service_role key here or anywhere in this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The Flask API this app calls from the server (openapi.yaml `servers`).
NIDAN_API_URL=http://localhost:8000/v1

# Where Supabase sends people back to after email links and OAuth.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
